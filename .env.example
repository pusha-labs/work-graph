# Generate a unique 32-byte key; never commit the populated .env file.
# openssl rand -base64 32
WORK_GRAPH_MASTER_KEY=

# Required by compose.production.yaml. Use a long URL-safe random value.
POSTGRES_PASSWORD=

# Persistent host storage used by compose.production.yaml.
WORK_GRAPH_DATA_DIR=/mnt/data/work-graph

# Optional host port for the web interface. Defaults to 8088.
WORK_GRAPH_PORT=8088

# Required only when the opt-in HTTP runner is enabled.
RUNNER_TOKEN=
HTTP_RUNNER_ALLOWED_HOSTS=

# Use "open" for a public service. The default keeps self-hosted instances invitation-only.
WORK_GRAPH_REGISTRATION_MODE=invite_only

# Optional. Required for password-reset email delivery.
WORK_GRAPH_PUBLIC_URL=
WORK_GRAPH_EMAIL_FROM=
WORK_GRAPH_SMTP_ADDRESS=
WORK_GRAPH_SMTP_USERNAME=
WORK_GRAPH_SMTP_PASSWORD=
